  // Build question item for display
  Widget _buildQuestionItem(
    Map<String, dynamic> question, 
    int index, 
    List<Map<String, dynamic>> questions, 
    StateSetter setDialogState
  ) {
    return Container(
      margin: const EdgeInsets.symmetric(horizontal: 8, vertical: 4),
      padding: const EdgeInsets.all(12),
      decoration: BoxDecoration(
        color: Colors.white,
        borderRadius: BorderRadius.circular(8),
        border: Border.all(color: Colors.grey.withOpacity(0.3)),
      ),
      child: Row(
        children: [
          // Question info
          Expanded(
            child: Column(
              crossAxisAlignment: CrossAxisAlignment.start,
              children: [
                Row(
                  children: [
                    _buildQuestionTypeChip(question['type'] ?? 'mcq'),
                    const SizedBox(width: 8),
                    Container(
                      padding: const EdgeInsets.symmetric(horizontal: 6, vertical: 2),
                      decoration: BoxDecoration(
                        color: AppTheme.primaryGreen.withOpacity(0.1),
                        borderRadius: BorderRadius.circular(4),
                      ),
                      child: Text(
                        '${question['points'] ?? 1} pts',
                        style: const TextStyle(
                          fontSize: 10,
                          color: AppTheme.primaryGreen,
                          fontWeight: FontWeight.w500,
                        ),
                      ),
                    ),
                  ],
                ),
                const SizedBox(height: 4),
                Text(
                  question['question'] ?? '',
                  style: const TextStyle(
                    fontSize: 14,
                    fontWeight: FontWeight.w500,
                  ),
                  maxLines: 2,
                  overflow: TextOverflow.ellipsis,
                ),
                if (question['type'] == 'mcq' && question['options'] != null)
                  Text(
                    '${question['options'].length} options',
                    style: TextStyle(
                      fontSize: 12,
                      color: const Color(0xFF757575),
                    ),
                  ),
              ],
            ),
          ),
          
          // Actions
          PopupMenuButton<String>(
            icon: const Icon(Icons.more_vert, size: 18),
            onSelected: (value) {
              switch (value) {
                case 'edit':
                  _editQuestionInQuiz(question, index, questions, setDialogState);
                  break;
                case 'delete':
                  setDialogState(() {
                    questions.removeAt(index);
                  });
                  break;
              }
            },
            itemBuilder: (context) => [
              const PopupMenuItem(
                value: 'edit',
                child: Row(
                  children: [
                    Icon(Icons.edit, size: 16),
                    SizedBox(width: 8),
                    Text('Edit'),
                  ],
                ),
              ),
              const PopupMenuItem(
                value: 'delete',
                child: Row(
                  children: [
                    Icon(Icons.delete, size: 16, color: Colors.red),
                    SizedBox(width: 8),
                    Text('Delete', style: TextStyle(color: Colors.red)),
                  ],
                ),
              ),
            ],
          ),
        ],
      ),
    );
  }

  // Edit question in quiz
  void _editQuestionInQuiz(
    Map<String, dynamic> question,
    int index,
    List<Map<String, dynamic>> questions,
    StateSetter setDialogState
  ) {
    final questionController = TextEditingController(text: question['question']);
    String selectedType = question['type'] ?? 'mcq';
    int points = question['points'] ?? 1;
    
    // MCQ specific
    final optionsControllers = question['options'] != null
        ? (question['options'] as List).map((opt) => TextEditingController(text: opt['text'])).toList()
        : [TextEditingController(), TextEditingController(), TextEditingController(), TextEditingController()];
    int correctAnswer = question['correctAnswer'] ?? 0;
    
    // True/False specific
    bool trueFalseAnswer = question['correctAnswer'] ?? true;
    
    // Essay specific
    final essayAnswerController = TextEditingController(text: question['sampleAnswer'] ?? '');
    
    // Fill blank specific
    final blankAnswerController = TextEditingController(text: question['correctAnswer'] ?? '');
    
    showDialog(
      context: context,
      builder: (context) => StatefulBuilder(
        builder: (context, setQuestionDialogState) => AlertDialog(
          title: Text('Edit ${_getQuestionTypeLabel(selectedType)} Question'),
          content: SizedBox(
            width: MediaQuery.of(context).size.width * 0.6,
            child: SingleChildScrollView(
              child: Column(
                mainAxisSize: MainAxisSize.min,
                crossAxisAlignment: CrossAxisAlignment.start,
                children: [
                  // Question Type (disabled for editing)
                  DropdownButtonFormField<String>(
                    value: selectedType,
                    decoration: const InputDecoration(
                      labelText: 'Question Type',
                      border: OutlineInputBorder(),
                    ),
                    items: const [
                      DropdownMenuItem(value: 'mcq', child: Text('Multiple Choice')),
                      DropdownMenuItem(value: 'true_false', child: Text('True/False')),
                      DropdownMenuItem(value: 'essay', child: Text('Essay')),
                      DropdownMenuItem(value: 'fill_blank', child: Text('Fill in the Blank')),
                    ],
                    onChanged: null, // Disable type change for editing
                  ),
                  const SizedBox(height: 16),
                  
                  // Question Text
                  TextField(
                    controller: questionController,
                    decoration: const InputDecoration(
                      labelText: 'Question',
                      border: OutlineInputBorder(),
                    ),
                    maxLines: 3,
                  ),
                  const SizedBox(height: 16),
                  
                  // Points
                  TextFormField(
                    initialValue: points.toString(),
                    keyboardType: TextInputType.number,
                    decoration: const InputDecoration(
                      labelText: 'Points',
                      border: OutlineInputBorder(),
                    ),
                    onChanged: (value) {
                      points = int.tryParse(value) ?? 1;
                    },
                  ),
                  const SizedBox(height: 16),
                  
                  // Type-specific fields (same as in add dialog)
                  if (selectedType == 'mcq') ...[
                    const Text('Options:'),
                    const SizedBox(height: 8),
                    ...optionsControllers.asMap().entries.map((entry) {
                      final index = entry.key;
                      final controller = entry.value;
                      return Padding(
                        padding: const EdgeInsets.only(bottom: 8),
                        child: Row(
                          children: [
                            Radio<int>(
                              value: index,
                              groupValue: correctAnswer,
                              onChanged: (value) {
                                setQuestionDialogState(() {
                                  correctAnswer = value!;
                                });
                              },
                            ),
                            Expanded(
                              child: TextField(
                                controller: controller,
                                decoration: InputDecoration(
                                  labelText: 'Option ${String.fromCharCode(65 + index)}',
                                  border: const OutlineInputBorder(),
                                ),
                              ),
                            ),
                          ],
                        ),
                      );
                    }).toList(),
                  ] else if (selectedType == 'true_false') ...[
                    const Text('Correct Answer:'),
                    const SizedBox(height: 8),
                    Row(
                      children: [
                        Expanded(
                          child: RadioListTile<bool>(
                            title: const Text('True'),
                            value: true,
                            groupValue: trueFalseAnswer,
                            onChanged: (value) {
                              setQuestionDialogState(() {
                                trueFalseAnswer = value!;
                              });
                            },
                          ),
                        ),
                        Expanded(
                          child: RadioListTile<bool>(
                            title: const Text('False'),
                            value: false,
                            groupValue: trueFalseAnswer,
                            onChanged: (value) {
                              setQuestionDialogState(() {
                                trueFalseAnswer = value!;
                              });
                            },
                          ),
                        ),
                      ],
                    ),
                  ] else if (selectedType == 'essay') ...[
                    TextField(
                      controller: essayAnswerController,
                      decoration: const InputDecoration(
                        labelText: 'Sample Answer (Optional)',
                        border: OutlineInputBorder(),
                      ),
                      maxLines: 4,
                    ),
                  ] else if (selectedType == 'fill_blank') ...[
                    TextField(
                      controller: blankAnswerController,
                      decoration: const InputDecoration(
                        labelText: 'Correct Answer',
                        border: OutlineInputBorder(),
                      ),
                    ),
                  ],
                ],
              ),
            ),
          ),
          actions: [
            TextButton(
              onPressed: () => Navigator.pop(context),
              child: const Text('Cancel'),
            ),
            ElevatedButton(
              onPressed: () async {
                if (questionController.text.trim().isEmpty) {
                  ScaffoldMessenger.of(context).showSnackBar(
                    const SnackBar(content: Text('Question is required')),
                  );
                  return;
                }
                
                // Type-specific validation (same as add dialog)
                if (selectedType == 'mcq' && optionsControllers.any((c) => c.text.trim().isEmpty)) {
                  ScaffoldMessenger.of(context).showSnackBar(
                    const SnackBar(content: Text('All options are required')),
                  );
                  return;
                }
                
                // Update question data
                final updatedQuestion = {
                  'question': questionController.text.trim(),
                  'type': selectedType,
                  'points': points,
                  'id': question['id'],
                };
                
                // Add type-specific data
                if (selectedType == 'mcq') {
                  updatedQuestion['options'] = optionsControllers
                      .asMap()
                      .entries
                      .map((entry) => {
                            'id': question['options']?[entry.key]?['id'] ?? DateTime.now().millisecondsSinceEpoch.toString() + '_' + entry.key.toString(),
                            'text': entry.value.text.trim(),
                            'isCorrect': entry.key == correctAnswer,
                          })
                      .toList();
                  updatedQuestion['correctAnswer'] = correctAnswer;
                } else if (selectedType == 'true_false') {
                  updatedQuestion['correctAnswer'] = trueFalseAnswer;
                } else if (selectedType == 'essay') {
                  updatedQuestion['sampleAnswer'] = essayAnswerController.text.trim();
                } else if (selectedType == 'fill_blank') {
                  updatedQuestion['correctAnswer'] = blankAnswerController.text.trim();
                }
                
                Navigator.pop(context);
                setDialogState(() {
                  questions[index] = updatedQuestion;
                });
              },
              child: const Text('Update Question'),
            ),
          ],
        ),
      ),
    );
  }

  // Get question type label
  String _getQuestionTypeLabel(String type) {
    switch (type) {
      case 'mcq':
        return 'Multiple Choice';
      case 'true_false':
        return 'True/False';
      case 'essay':
        return 'Essay';
      case 'fill_blank':
        return 'Fill in the Blank';
      case 'drag_drop':
        return 'Drag & Drop';
      case 'matching':
        return 'Matching';
      case 'ordering':
        return 'Ordering';
      case 'hotspot':
        return 'Hotspot';
      default:
        return type.toUpperCase();
    }
  }
}

// Extension to capitalize first letter
extension StringExtension on String {
  String capitalize() {
    return "${this[0].toUpperCase()}${substring(1).toLowerCase()}";
  }
}
